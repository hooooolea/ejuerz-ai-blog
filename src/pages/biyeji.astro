---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="毕业季留言墙 | 工商人共享" description="写下你想说的话，送给每一个即将离开的同学。">
  <Header />
  <main id="main-content" class="app-layout mt-8">

    <section class="border-border border-b py-12">
      <h1 class="mb-3 text-4xl font-bold sm:text-5xl">毕业季留言墙</h1>
      <p class="text-muted-foreground max-w-md text-base">写下你想说的话，送给每一个即将离开的同学。</p>
    </section>

    <!-- 留言表单 -->
    <section class="py-8 border-border border-b">
      <form id="msg-form" class="flex flex-col gap-4 max-w-lg">
        <input
          id="msg-name"
          type="text"
          placeholder="你的昵称（最多 20 字）"
          maxlength="20"
          class="border-border bg-background text-foreground rounded-md border px-4 py-2 text-sm outline-none focus:ring-1 focus:ring-current"
        />
        <textarea
          id="msg-text"
          placeholder="留言内容（最多 200 字）"
          maxlength="200"
          rows="3"
          class="border-border bg-background text-foreground rounded-md border px-4 py-2 text-sm outline-none focus:ring-1 focus:ring-current resize-none"
        ></textarea>
        <!-- 分类选择 -->
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer text-sm">
            <input type="radio" name="category" value="感谢" checked class="accent-current" />
            🙏 感谢
          </label>
          <label class="flex items-center gap-2 cursor-pointer text-sm">
            <input type="radio" name="category" value="吐槽" class="accent-current" />
            😤 吐槽
          </label>
        </div>
        <div class="flex items-center gap-4">
          <button
            type="submit"
            class="bg-foreground text-background rounded-md px-5 py-2 text-sm font-medium active:opacity-70 transition-opacity"
          >
            发送
          </button>
          <span id="msg-status" class="text-muted-foreground text-sm"></span>
        </div>
      </form>
    </section>

    <!-- Tab 切换 -->
    <section class="pt-8">
      <div class="flex gap-1 mb-6 border-border border-b">
        {["全部", "感谢", "吐槽"].map(tab => (
          <button
            data-tab={tab}
            class:list={[
              "tab-btn px-4 py-2 text-sm transition-colors",
              tab === "全部"
                ? "text-foreground border-b-2 border-current -mb-px font-medium"
                : "text-muted-foreground hover:text-foreground"
            ]}
          >
            {tab === "全部" ? "全部" : tab === "感谢" ? "🙏 感谢" : "😤 吐槽"}
          </button>
        ))}
      </div>

      <div id="msg-list" class="grid gap-4 sm:grid-cols-2 pb-12">
        <p class="text-muted-foreground text-sm col-span-2">加载中...</p>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  const API = "/api/messages";

  interface Message {
    id: number;
    name: string;
    message: string;
    category: string;
    created_at: string;
  }

  function formatDate(iso: string) {
    const d = new Date(iso);
    return d.toLocaleDateString("zh-CN", { month: "long", day: "numeric" });
  }

  function escHtml(str: string) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function renderMessages(messages: Message[]) {
    const list = document.getElementById("msg-list")!;
    if (messages.length === 0) {
      list.innerHTML = '<p class="text-muted-foreground text-sm col-span-2">还没有留言，成为第一个吧。</p>';
      return;
    }
    list.innerHTML = messages
      .map(
        m => `
        <div class="border-border rounded-lg border p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs px-2 py-0.5 rounded-full border border-border text-muted-foreground">
              ${m.category === "感谢" ? "🙏 感谢" : "😤 吐槽"}
            </span>
          </div>
          <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap">${escHtml(m.message)}</p>
          <div class="mt-3 flex items-center justify-between">
            <span class="text-accent text-sm font-medium">${escHtml(m.name)}</span>
            <span class="text-muted-foreground text-xs">${formatDate(m.created_at)}</span>
          </div>
        </div>`
      )
      .join("");
  }

  async function loadMessages(category?: string) {
    const list = document.getElementById("msg-list")!;
    list.innerHTML = '<p class="text-muted-foreground text-sm col-span-2">加载中...</p>';
    try {
      const url = category && category !== "全部" ? `${API}?category=${encodeURIComponent(category)}` : API;
      const res = await fetch(url);
      const data: Message[] = await res.json();
      renderMessages(data);
    } catch {
      list.innerHTML = '<p class="text-muted-foreground text-sm col-span-2">加载失败，请刷新重试。</p>';
    }
  }

  document.addEventListener("astro:page-load", () => {
    let activeTab = "全部";
    loadMessages();

    // Tab 切换
    document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        activeTab = btn.dataset.tab!;
        document.querySelectorAll(".tab-btn").forEach(b => {
          b.classList.remove("text-foreground", "border-b-2", "border-current", "-mb-px", "font-medium");
          b.classList.add("text-muted-foreground");
        });
        btn.classList.add("text-foreground", "border-b-2", "border-current", "-mb-px", "font-medium");
        btn.classList.remove("text-muted-foreground");
        loadMessages(activeTab);
      });
    });

    // 表单提交
    const form = document.getElementById("msg-form") as HTMLFormElement;
    const status = document.getElementById("msg-status")!;

    form.addEventListener("submit", async e => {
      e.preventDefault();

      const lastSent = localStorage.getItem("msg_last_sent");
      if (lastSent && Date.now() - parseInt(lastSent) < 5 * 60 * 1000) {
        status.textContent = "发送太频繁，请稍后再试";
        return;
      }

      const name = (document.getElementById("msg-name") as HTMLInputElement).value.trim();
      const message = (document.getElementById("msg-text") as HTMLTextAreaElement).value.trim();
      const category = (form.querySelector('input[name="category"]:checked') as HTMLInputElement)?.value ?? "感谢";

      if (!name || !message) {
        status.textContent = "昵称和留言不能为空";
        return;
      }

      status.textContent = "发送中...";

      try {
        const res = await fetch(API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, message, category }),
        });

        if (res.ok) {
          localStorage.setItem("msg_last_sent", String(Date.now()));
          (document.getElementById("msg-name") as HTMLInputElement).value = "";
          (document.getElementById("msg-text") as HTMLTextAreaElement).value = "";
          status.textContent = "发送成功 ✓";
          await loadMessages(activeTab);
          setTimeout(() => (status.textContent = ""), 3000);
        } else {
          const err = await res.json() as { error?: string };
          status.textContent = err.error ?? "发送失败";
        }
      } catch {
        status.textContent = "网络错误，请重试";
      }
    });
  });
</script>
