---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="投稿说明 | 工商人共享"
  description="向工商人共享平台投稿，分享你的笔记、经验、资源。"
>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Hero -->
    <section class="border-border border-b py-12">
      <a href="/forbtbuer" class="text-muted-foreground hover:text-foreground mb-6 inline-block text-sm transition-colors">← 工商人共享</a>
      <h1 class="mb-3 text-4xl font-bold sm:text-5xl">投稿说明</h1>
      <p class="text-muted-foreground max-w-sm text-base">
        发邮件就行，没有格式要求。
      </p>
      <div class="mt-6">
        <a id="email-fast" href="#" class="bg-foreground text-background hover:opacity-80 rounded-lg px-5 py-2.5 text-sm font-semibold transition-opacity">
          发邮件
        </a>
        <p class="text-muted-foreground mt-3 text-xs">工商大同学发快速通道，优先处理，尽量当天回复</p>
      </div>
    </section>

    <!-- Content split -->
    <section class="border-border grid gap-12 border-b py-12 sm:grid-cols-2">

      <div>
        <h2 class="mb-5 text-lg font-semibold">可以发什么</h2>
        <ul class="text-muted-foreground space-y-3 text-sm">
          {[
            ["学习笔记 / 课件", "期末笔记、课程总结、重点整理，科目不限"],
            ["选课 / 考试经验", "哪门课好过，考试有什么坑，实习面试踩过的雷"],
            ["资源推荐", "好用的网站、工具、书单，觉得值得分享的都行"],
            ["自己做的项目", "课设、比赛项目、课外小工具"],
            ["随便写点什么", "实习感悟、校园生活、想对同学说的话"],
          ].map(([title, desc]) => (
            <li>
              <span class="text-foreground font-medium">{title}</span>
              <span class="mx-2">—</span>
              {desc}
            </li>
          ))}
        </ul>
        <p class="text-muted-foreground mt-4 text-xs">发邮件时附上想用的署名（可以是昵称），不填默认匿名。</p>
      </div>

      <div>
        <h2 class="mb-5 text-lg font-semibold">建议新板块</h2>
        <p class="text-muted-foreground text-sm">
          如果你觉得还缺一个板块，发邮件时说明就行。比如"想加一个 XX 板块"，收到后会评估，合适的会加上。
        </p>
        <p class="text-muted-foreground mt-3 text-sm">
          现有板块：<strong class="text-foreground font-medium">竞赛经验</strong>、<strong class="text-foreground font-medium">课设项目</strong>、<strong class="text-foreground font-medium">求职实习</strong>、<strong class="text-foreground font-medium">工具技巧</strong>、<strong class="text-foreground font-medium">踩坑记录</strong>。
        </p>
      </div>

      <div>
        <h2 class="mb-5 text-lg font-semibold">常见问题</h2>
        <div class="space-y-4 text-sm">
          {[
            ["署名怎么填？", "邮件里带上你想用的名字就行，真名、昵称、网名都可以。不填就匿名发布。"],
            ["会署名吗？", "你想署就署，不想就匿名，完全你说了算。"],
            ["内容会被修改吗？", "只做基本格式整理，内容不动。有问题会先跟你说。"],
            ["有什么不能发的？", "侵权、隐私、广告不行，其他都欢迎。请确认内容为本人原创或有权分享。"],
            ["多久会发布？", "一般 2-3 天内，会回邮件告知。"],
          ].map(([q, a]) => (
            <div>
              <p class="text-foreground mb-0.5 font-medium">{q}</p>
              <p class="text-muted-foreground">{a}</p>
            </div>
          ))}
        </div>
      </div>

    </section>

    <!-- Other email -->
    <section class="border-border border-t py-8">
      <p class="text-muted-foreground text-sm">
        非工商大同学也欢迎投稿，发 <a id="email-other" href="#" class="text-foreground underline underline-offset-2"></a> 即可。
      </p>
      <p class="text-muted-foreground mt-3 text-sm">
        如果本站内容侵犯了您的权利，请发邮件至 <a id="email-dmca" href="#" class="text-foreground underline underline-offset-2"></a> 说明情况，核实后即刻下架。
      </p>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  const fast = document.getElementById("email-fast") as HTMLAnchorElement | null;
  const other = document.getElementById("email-other") as HTMLAnchorElement | null;
  const dmca = document.getElementById("email-dmca") as HTMLAnchorElement | null;
  const u1 = "hoooooyea", u2 = "ejuer_z", d = "163.com";
  if (fast) { fast.href = `mailto:${u1}@${d}?subject=工商共享投稿`; }
  if (other) { other.href = `mailto:${u2}@${d}?subject=工商共享投稿`; other.textContent = `${u2}@${d}`; }
  if (dmca) { dmca.href = `mailto:${u2}@${d}?subject=侵权投诉`; dmca.textContent = `${u2}@${d}`; }
</script>
