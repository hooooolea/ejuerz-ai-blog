---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="如何投稿 | 工商人共享"
  description="向工商人共享平台投稿，分享你的笔记、经验、资源。"
>
  <Header />
  <main id="main-content" class="app-layout py-12">

    <div class="mb-10">
      <a href="/forbtbuer" class="text-muted-foreground hover:text-foreground text-sm transition-colors">← 返回工商共享</a>
    </div>

    <div class="mb-10 text-center">
      <div class="mb-4 text-5xl">📬</div>
      <h1 class="mb-3 text-3xl font-bold">怎么投稿？</h1>
      <p class="text-muted-foreground mx-auto max-w-md">
        发邮件就行，没有固定格式，说清楚内容是什么就行。
      </p>
    </div>

    <!-- Fast track -->
    <div class="bg-accent/10 border-accent/30 mx-auto mb-8 max-w-lg rounded-2xl border p-6 text-center">
      <p class="text-accent mb-1 font-semibold">⚡ 工商大同学专属快速通道</p>
      <p class="text-muted-foreground mb-4 text-sm">优先处理，当天回复</p>
      <a
        href="mailto:hoooooyea@163.com?subject=工商共享投稿"
        class="bg-accent text-background hover:opacity-80 inline-block rounded-xl px-8 py-3 font-semibold transition-opacity"
      >
        hoooooyea@163.com
      </a>
    </div>

    <p class="text-muted-foreground mb-12 text-center text-sm">
      其他同学可以发 <a href="mailto:ejuer_z@163.com?subject=工商共享投稿" class="underline">ejuer_z@163.com</a>
    </p>

    <!-- What to share -->
    <div class="mb-12">
      <h2 class="mb-6 text-center text-xl font-semibold">可以发什么？</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: "📝", title: "学习笔记 / 课件", desc: "期末笔记、课程总结、重点整理" },
          { icon: "💡", title: "选课 / 考试经验", desc: "哪门课好过，考试有什么坑" },
          { icon: "🔗", title: "资源推荐", desc: "好用的网站、工具、书单" },
          { icon: "🚀", title: "自己做的项目", desc: "课设、比赛项目、小工具" },
          { icon: "✍️", title: "随便写点什么", desc: "实习感悟、校园生活、踩过的坑" },
          { icon: "🤷", title: "不确定？直接发", desc: "你觉得有用就行，没有限制" },
        ].map(({ icon, title, desc }) => (
          <div class="border-border rounded-xl border p-4">
            <div class="mb-2 text-2xl">{icon}</div>
            <p class="mb-1 font-medium text-sm">{title}</p>
            <p class="text-muted-foreground text-xs">{desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- FAQ -->
    <div class="mx-auto max-w-lg">
      <h2 class="mb-4 text-xl font-semibold">常见问题</h2>
      <div class="space-y-3">
        {[
          { q: "会署名吗？", a: "你想署就署，不想就匿名，你说了算。" },
          { q: "内容会被修改吗？", a: "只做基本格式整理，内容不动。有问题先跟你说。" },
          { q: "有没有什么不能发的？", a: "侵权、隐私、广告不行，其他都欢迎。" },
          { q: "多久会发布？", a: "一般 2-3 天内，会回邮件告知。" },
        ].map(({ q, a }) => (
          <div class="border-border rounded-xl border p-4">
            <p class="mb-1 font-medium text-sm">{q}</p>
            <p class="text-muted-foreground text-sm">{a}</p>
          </div>
        ))}
      </div>
    </div>

  </main>
  <Footer />
</Layout>
