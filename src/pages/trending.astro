---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="GitHub Trending | AI Toolkit Guide"
  description="Explore what's hot on GitHub right now — top open source projects filtered by language and time period."
>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <!-- Page header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">🔥 GitHub Trending</h1>
      <p class="text-muted-foreground">
        Top open source projects gaining traction right now.
      </p>
    </div>

    <!-- Filters -->
    <div class="flex flex-col gap-4 mb-8 sm:flex-row sm:items-center sm:justify-between">
      <!-- Time period -->
      <div class="flex gap-2">
        {
          [
            { label: "Today", value: "daily" },
            { label: "This Week", value: "weekly" },
            { label: "This Month", value: "monthly" },
          ].map(({ label, value }) => (
            <button
              class="period-btn px-3 py-1.5 rounded-full text-sm font-medium border border-border transition-colors hover:border-accent"
              data-period={value}
            >
              {label}
            </button>
          ))
        }
      </div>

      <!-- Language filter -->
      <div class="flex flex-wrap gap-2">
        {
          [
            "All",
            "Python",
            "JavaScript",
            "TypeScript",
            "Go",
            "Rust",
            "Java",
            "C++",
          ].map(lang => (
            <button
              class="lang-btn px-3 py-1 rounded-full text-xs font-medium border border-border transition-colors hover:border-accent"
              data-lang={lang === "All" ? "" : lang}
            >
              {lang}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Results -->
    <div id="trending-list" class="space-y-3">
      <div class="skeleton-list">
        {
          Array(10)
            .fill(0)
            .map(() => (
              <div class="border border-border rounded-lg p-4 animate-pulse">
                <div class="h-4 bg-muted rounded w-1/3 mb-2" />
                <div class="h-3 bg-muted rounded w-2/3" />
              </div>
            ))
        }
      </div>
    </div>

    <p id="trending-error" class="hidden text-muted-foreground text-sm mt-4">
      Failed to load. GitHub API rate limit may be reached — try again in a minute.
    </p>
  </main>
  <Footer />
</Layout>

<style>
  .period-btn.active,
  .lang-btn.active {
    background-color: var(--accent);
    color: var(--accent-foreground);
    border-color: var(--accent);
  }

  .repo-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .repo-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  }

  .repo-rank {
    color: var(--muted-foreground);
    font-size: 0.8rem;
    font-family: monospace;
    width: 1.5rem;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .repo-name {
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.15s;
  }

  .repo-card:hover .repo-name {
    color: var(--accent);
  }

  .repo-desc {
    color: var(--muted-foreground);
    font-size: 0.83rem;
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .repo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--muted-foreground);
  }

  .repo-lang-badge {
    background-color: var(--muted);
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.72rem;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
  .animate-pulse {
    animation: pulse 1.5s ease-in-out infinite;
  }
</style>

<script>
  type Period = "daily" | "weekly" | "monthly";

  const periodDays: Record<Period, number> = {
    daily: 1,
    weekly: 7,
    monthly: 30,
  };

  let currentPeriod: Period = "weekly";
  let currentLang = "";

  function getDateBefore(days: number): string {
    const d = new Date();
    d.setDate(d.getDate() - days);
    return d.toISOString().split("T")[0];
  }

  function fmt(n: number): string {
    if (n >= 1000) return (n / 1000).toFixed(1) + "k";
    return String(n);
  }

  function renderRepos(repos: any[]) {
    const list = document.getElementById("trending-list");
    if (!list) return;

    if (repos.length === 0) {
      list.innerHTML =
        '<p class="text-muted-foreground">No results found. Try a different filter.</p>';
      return;
    }

    list.innerHTML = repos
      .map(
        (repo, i) => `
      <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer" class="repo-card">
        <span class="repo-rank">${i + 1}</span>
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
            <span class="repo-name">${repo.full_name}</span>
            ${repo.language ? `<span class="repo-lang-badge">${repo.language}</span>` : ""}
          </div>
          <p class="repo-desc">${repo.description ?? "No description provided."}</p>
          <div class="repo-meta">
            <span>⭐ ${fmt(repo.stargazers_count)}</span>
            <span>🍴 ${fmt(repo.forks_count)}</span>
            <span>👀 ${fmt(repo.watchers_count)}</span>
          </div>
        </div>
      </a>`
      )
      .join("");
  }

  function showSkeleton() {
    const list = document.getElementById("trending-list");
    if (!list) return;
    list.innerHTML = Array(10)
      .fill(0)
      .map(
        () => `
      <div style="border:1px solid var(--border);border-radius:0.5rem;padding:1rem" class="animate-pulse">
        <div style="height:1rem;background:var(--muted);border-radius:4px;width:33%;margin-bottom:0.5rem"></div>
        <div style="height:0.75rem;background:var(--muted);border-radius:4px;width:66%"></div>
      </div>`
      )
      .join("");
  }

  async function fetchTrending() {
    showSkeleton();
    const errorEl = document.getElementById("trending-error");
    if (errorEl) errorEl.classList.add("hidden");

    const days = periodDays[currentPeriod];
    const since = getDateBefore(days);
    const langQ = currentLang ? `+language:${currentLang}` : "";
    const url = `https://api.github.com/search/repositories?q=stars:>100+pushed:>${since}${langQ}&sort=stars&order=desc&per_page=25`;

    try {
      const res = await fetch(url, {
        headers: { Accept: "application/vnd.github+json" },
      });

      if (!res.ok) throw new Error("API error");
      const data = await res.json();
      renderRepos(data.items ?? []);
    } catch {
      const list = document.getElementById("trending-list");
      if (list) list.innerHTML = "";
      if (errorEl) errorEl.classList.remove("hidden");
    }
  }

  function initTrending() {
    // Set default active states
    document
      .querySelectorAll<HTMLButtonElement>(".period-btn")
      .forEach(btn => {
        btn.classList.toggle("active", btn.dataset.period === currentPeriod);
        btn.addEventListener("click", () => {
          currentPeriod = btn.dataset.period as Period;
          document
            .querySelectorAll(".period-btn")
            .forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          fetchTrending();
        });
      });

    document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.lang === currentLang);
      btn.addEventListener("click", () => {
        currentLang = btn.dataset.lang ?? "";
        document
          .querySelectorAll(".lang-btn")
          .forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        fetchTrending();
      });
    });

    fetchTrending();
  }

  document.addEventListener("astro:page-load", initTrending);
</script>
