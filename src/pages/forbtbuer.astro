---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const SECTIONS = [
  { id: "jing-sai", label: "竞赛经验", desc: "比赛项目、参赛经验、获奖技巧" },
  { id: "ke-she", label: "课设项目", desc: "课程设计、大作业、学期项目" },
  { id: "qiu-zhi", label: "求职实习", desc: "面试经验、实习心得、简历技巧" },
  { id: "xue-xi-zi-liao", label: "学习资料", desc: "笔记、真题、课件，按课程整理" },
  { id: "cai-keng", label: "踩坑记录", desc: "避坑指南、错误排查、经验教训" },
  { id: "campus-pets", label: "校园宠物", desc: "校园里的学长学姐们" },
];
---

<Layout
  title="工商人共享 | AI Toolkit Guide"
  description="工商大同学的内容共享平台——笔记、经验、资源，由同学写给同学。"
>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Hero -->
    <section class="border-border border-b py-12">
      <p class="text-muted-foreground mb-2 text-sm font-medium tracking-widest uppercase">For BTBU</p>
      <h1 class="mb-3 text-4xl font-bold sm:text-5xl">工商人共享</h1>
      <p class="text-muted-foreground max-w-md text-base">
        同学写给同学的笔记、经验和资源。欢迎投稿。
      </p>
      <div class="mt-6 flex items-center gap-4">
        <a
          href="/btbuer-submit"
          class="bg-foreground text-background hover:opacity-80 active:opacity-60 active:scale-95 rounded-lg px-5 py-2.5 text-sm font-semibold transition-all"
        >
          投稿说明
        </a>
        <a id="email-link" href="#" class="text-muted-foreground hover:text-foreground active:opacity-50 text-sm transition-all">
          发邮件
        </a>
      </div>
    </section>

    <!-- Section Cards -->
    <section class="py-10">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {SECTIONS.map(({ id, label, desc }) => (
          <a
            href={`/forbtbuer/${id}`}
            class="border-border group flex flex-col gap-2 rounded-lg border p-5 transition-all hover:border-foreground active:bg-foreground/5 active:scale-[0.98]"
          >
            <h2 class="text-lg font-semibold group-hover:underline">{label}</h2>
            <p class="text-muted-foreground text-sm">{desc}</p>
          </a>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    if (main) {
      main.setAttribute("data-backurl", "/forbtbuer/");
      sessionStorage.setItem("backUrl", "/forbtbuer/");
    }
  });

  const u = "hoooooyea";
  const d = "163.com";
  const el = document.getElementById("email-link") as HTMLAnchorElement | null;
  if (el) {
    el.href = `mailto:${u}@${d}?subject=工商共享投稿`;
    el.textContent = `${u}@${d}`;
  }
</script>
