---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BtbuerNavbar from "@/components/forbtbuer/BtbuerNavbar.vue";
import BtbuerHero from "@/components/forbtbuer/BtbuerHero.vue";
import SectionExploreList from "@/components/forbtbuer/SectionExploreList.vue";
import { BTBUER_SECTIONS } from "@/constants/btbuer-sections";

const allPosts = await getCollection("btbuer");

const sectionsWithCount = BTBUER_SECTIONS.map(section => ({
  ...section,
  postCount: allPosts.filter(
    p => p.id.startsWith(`${section.id}/`) && !p.data.draft && !p.data.parent
  ).length,
})).filter(section => section.postCount > 0);
---

<Layout
  title="工商人共享"
  description="工商大同学的内容共享平台——笔记、经验、资源，由同学写给同学。"
>
  <BtbuerNavbar client:load />
  <main id="main-content" class="app-layout pb-10">
    <BtbuerHero />
    <SectionExploreList sections={sectionsWithCount} />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    if (main) {
      main.setAttribute("data-backurl", "/forbtbuer/");
      sessionStorage.setItem("backUrl", "/forbtbuer/");
    }
  });
</script>
