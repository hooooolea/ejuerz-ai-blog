---
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/getSortedPosts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

const allPosts = await getCollection("posts");
const btbuerPosts = getSortedPosts(allPosts).filter(p =>
  p.data.tags?.includes("btbuer")
);
---

<Layout
  title="工商人共享 | AI Toolkit Guide"
  description="工商大同学的内容共享平台——笔记、经验、资源，由同学写给同学。"
>
  <Header />
  <main id="main-content" class="app-layout py-10">

    <!-- Header row -->
    <div class="border-border mb-8 flex items-end justify-between border-b pb-6">
      <div>
        <h1 class="mb-1 text-3xl font-bold">工商人共享</h1>
        <p class="text-muted-foreground text-sm">同学写给同学的笔记、经验和资源</p>
      </div>
      <a
        href="/btbuer-submit"
        class="border-border hover:border-foreground text-foreground rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
      >
        投稿
      </a>
    </div>

    <!-- Submit notice -->
    <div class="border-border mb-10 rounded-xl border p-5">
      <p class="mb-1 font-medium">有想分享的内容？</p>
      <p class="text-muted-foreground text-sm">
        笔记、选课经验、项目、随手写的东西都行。发邮件到
        <a href="mailto:hoooooyea@163.com?subject=工商共享投稿" class="text-foreground underline underline-offset-2">hoooooyea@163.com</a>，
        主题写「工商共享投稿」。详细说明见
        <a href="/btbuer-submit" class="text-foreground underline underline-offset-2">投稿页面</a>。
      </p>
    </div>

    <!-- Articles -->
    {btbuerPosts.length > 0 ? (
      <section>
        <ul>
          {btbuerPosts.map(post => (
            <Card variant="h3" {...post} />
          ))}
        </ul>
      </section>
    ) : (
      <div class="border-border rounded-xl border border-dashed py-24 text-center">
        <p class="font-medium">还没有内容</p>
        <p class="text-muted-foreground mt-2 text-sm">
          成为第一个投稿的同学 —
          <a href="/btbuer-submit" class="text-foreground underline underline-offset-2">查看投稿说明</a>
        </p>
      </div>
    )}

  </main>
  <Footer />
</Layout>
