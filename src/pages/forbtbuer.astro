---
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/getSortedPosts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

const allPosts = await getCollection("posts");
const btbuerPosts = getSortedPosts(allPosts).filter(p =>
  p.data.tags?.includes("btbuer")
);
---

<Layout
  title="工商人共享 | AI Toolkit Guide"
  description="工商大同学的内容共享平台——笔记、经验、资源，由同学写给同学。"
>
  <Header />
  <main id="main-content" class="app-layout py-10">

    <!-- Hero -->
    <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <h1 class="mb-1 text-3xl font-bold">🎓 工商人共享</h1>
        <p class="text-muted-foreground">同学写给同学的笔记、经验和资源</p>
      </div>
      <a
        href="/btbuer-submit"
        class="bg-accent text-background hover:opacity-80 flex-shrink-0 rounded-xl px-6 py-3 font-semibold transition-opacity"
      >
        ✍️ 我要投稿
      </a>
    </div>

    <!-- Submit banner -->
    <div class="border-accent/30 bg-accent/5 mb-10 flex flex-col items-start justify-between gap-3 rounded-2xl border p-5 sm:flex-row sm:items-center">
      <div>
        <p class="font-medium">📬 有想分享的内容？直接发过来</p>
        <p class="text-muted-foreground text-sm">
          笔记、选课经验、项目、随便写的都行 ——
          <a href="/btbuer-submit" class="text-accent underline underline-offset-2">查看投稿说明</a>
        </p>
      </div>
      <a
        href="mailto:hoooooyea@163.com?subject=工商共享投稿"
        class="border-accent text-accent hover:bg-accent hover:text-background flex-shrink-0 rounded-lg border px-5 py-2 text-sm font-medium transition-colors"
      >
        hoooooyea@163.com
      </a>
    </div>

    <!-- Articles -->
    {btbuerPosts.length > 0 ? (
      <section>
        <h2 class="mb-4 text-xl font-semibold">已发布的内容</h2>
        <ul>
          {btbuerPosts.map(post => (
            <Card variant="h3" {...post} />
          ))}
        </ul>
      </section>
    ) : (
      <div class="border-border rounded-2xl border border-dashed py-20 text-center">
        <div class="mb-3 text-4xl">📭</div>
        <p class="font-medium">还没有内容</p>
        <p class="text-muted-foreground mt-1 text-sm">
          成为第一个投稿的同学 →
          <a href="/btbuer-submit" class="text-accent underline underline-offset-2">投稿说明</a>
        </p>
      </div>
    )}

  </main>
  <Footer />
</Layout>
