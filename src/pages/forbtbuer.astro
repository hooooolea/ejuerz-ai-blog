---
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/getSortedPosts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

const SECTIONS = [
  { id: "jing sai", label: "竞赛经验" },
  { id: "ke she", label: "课设项目" },
  { id: "qiu zhi", label: "求职实习" },
  { id: "gong ju", label: "工具技巧" },
  { id: "cai keng", label: "踩坑记录" },
];

const SECTION_TAG_MAP: Record<string, string> = {
  "竞赛经验": "jing sai",
  "课设项目": "ke she",
  "求职实习": "qiu zhi",
  "工具技巧": "gong ju",
  "踩坑记录": "cai keng",
};

const allPosts = await getCollection("posts");
const btbuerPosts = getSortedPosts(allPosts).filter(p =>
  p.data.tags?.includes("btbuer")
);

// Group posts by section
const sectionPosts = SECTIONS.map(({ id, label }) => ({
  id,
  label,
  posts: btbuerPosts.filter(p => p.data.tags?.includes(label)),
})).filter(s => s.posts.length > 0);
---

<Layout
  title="工商人共享 | AI Toolkit Guide"
  description="工商大同学的内容共享平台——笔记、经验、资源，由同学写给同学。"
>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Hero -->
    <section class="border-border border-b py-12">
      <p class="text-muted-foreground mb-2 text-sm font-medium tracking-widest uppercase">For BTBU</p>
      <h1 class="mb-3 text-4xl font-bold sm:text-5xl">工商人共享</h1>
      <p class="text-muted-foreground max-w-md text-base">
        同学写给同学的笔记、经验和资源。有想分享的，直接发过来。
      </p>
      <div class="mt-6 flex items-center gap-4">
        <a
          href="/btbuer-submit"
          class="bg-foreground text-background hover:opacity-80 rounded-lg px-5 py-2.5 text-sm font-semibold transition-opacity"
        >
          投稿说明
        </a>
        <a id="email-link" href="#" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
          发邮件
        </a>
      </div>
    </section>

    <!-- Section Nav -->
    {sectionPosts.length > 0 && (
      <nav class="border-border sticky top-0 z-10 border-b bg-background/95 backdrop-blur py-3">
        <div class="flex gap-4 overflow-x-auto text-sm scrollbar-hide">
          {sectionPosts.map(({ id, label }) => (
            <a href={`#${id}`} class="whitespace-nowrap text-muted-foreground hover:text-foreground transition-colors">
              {label}
            </a>
          ))}
        </div>
      </nav>
    )}

    <!-- Sections with Posts -->
    <section class="py-10">
      {sectionPosts.length > 0 ? (
        sectionPosts.map(({ id, label, posts }) => (
          <div id={id} class="mb-12 scroll-mt-24">
            <h2 class="mb-6 text-xl font-semibold">{label}</h2>
            <ul>
              {posts.map(post => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
          </div>
        ))
      ) : (
        <div class="py-20 text-center">
          <p class="text-muted-foreground text-sm">还没有内容 — 成为第一个投稿的同学</p>
          <a href="/btbuer-submit" class="text-foreground mt-2 inline-block text-sm underline underline-offset-4">
            查看投稿说明
          </a>
        </div>
      )}
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    if (main) {
      main.setAttribute("data-backurl", "/forbtbuer/");
      sessionStorage.setItem("backUrl", "/forbtbuer/");
    }
  });

  const u = "hoooooyea";
  const d = "163.com";
  const el = document.getElementById("email-link") as HTMLAnchorElement | null;
  if (el) {
    el.href = `mailto:${u}@${d}?subject=工商共享投稿`;
    el.textContent = `${u}@${d}`;
  }
</script>
