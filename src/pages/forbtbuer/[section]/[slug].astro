---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import CommentSection from "@/components/CommentSection.astro";

const SECTIONS: Record<string, string> = {
  "jing-sai": "竞赛经验",
  "ke-she": "课设项目",
  "qiu-zhi": "求职实习",
  "xue-xi-zi-liao": "学习资料",
  "cai-keng": "踩坑记录",
  "hao-dong-xi": "好东西",
  "campus-pets": "校园宠物",
};

export async function getStaticPaths() {
  const allPosts = await getCollection("btbuer");
  const filtered = allPosts.filter(p => !p.data.draft);

  return filtered.map(post => {
    const parts = post.id.split("/");
    const section = parts[0];
    const slug = parts[parts.length - 1].replace(/\.(md|mdx)$/, "");

    // Adjacent posts within the same section, sorted by date
    // Posts with a parent field are sub-posts and excluded from prev/next navigation
    const sectionPosts = filtered
      .filter(p => p.id.startsWith(`${section}/`) && !p.data.parent)
      .sort((a, b) =>
        new Date(a.data.pubDatetime).getTime() -
        new Date(b.data.pubDatetime).getTime()
      );

    const idx = sectionPosts.findIndex(p => p.id === post.id);
    const prevPost = idx > 0 ? sectionPosts[idx - 1] : null;
    const nextPost = idx < sectionPosts.length - 1 ? sectionPosts[idx + 1] : null;

    const prevSlug = prevPost ? prevPost.id.split("/").pop()?.replace(/\.(md|mdx)$/, "") : null;
    const nextSlug = nextPost ? nextPost.id.split("/").pop()?.replace(/\.(md|mdx)$/, "") : null;

    return {
      params: { section, slug },
      props: {
        post,
        prevPost: prevPost ? { title: prevPost.data.title, href: `/forbtbuer/${section}/${prevSlug}` } : null,
        nextPost: nextPost ? { title: nextPost.data.title, href: `/forbtbuer/${section}/${nextSlug}` } : null,
      },
    };
  });
}

const { section } = Astro.params;
const { post, prevPost, nextPost } = Astro.props;
const { title, description, pubDatetime, modDatetime, timezone, author } = post.data;
const { Content } = await render(post);

const sectionLabel = SECTIONS[section] ?? section;
---

<Layout title={`${title} | 工商人共享`} description={description} noAds={true}>
  <Header />
  <main id="main-content" class="app-layout mt-8">

    <a
      href={`/forbtbuer/${section}`}
      class="text-muted-foreground hover:text-foreground mb-6 inline-block text-sm transition-colors"
    >
      ← {sectionLabel}
    </a>

    <h1 class="text-accent mt-4 block text-2xl font-bold sm:text-3xl">
      {title}
    </h1>

    <div class="my-2 flex items-center gap-x-3">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      {author && (
        <span class="text-muted-foreground text-sm before:mr-3 before:content-['·']">
          {author}
        </span>
      )}
    </div>

    <article
      data-pagefind-body
      data-pagefind-filter="area:btbuer"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <nav class="flex justify-between gap-4 text-sm">
      <div>
        {prevPost && (
          <a href={prevPost.href} class="text-muted-foreground hover:text-foreground active:opacity-50 transition-all">
            ← {prevPost.title}
          </a>
        )}
      </div>
      <div class="text-right">
        {nextPost && (
          <a href={nextPost.href} class="text-muted-foreground hover:text-foreground active:opacity-50 transition-all">
            {nextPost.title} →
          </a>
        )}
      </div>
    </nav>

    <CommentSection petSlug={Astro.params.slug} />

  </main>
  <Footer />
</Layout>

<style is:global>
  .app-prose a:active {
    opacity: 0.55;
  }
</style>
