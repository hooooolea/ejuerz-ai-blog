---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import SubmitForm from "@/components/SubmitForm.astro";

export function getStaticPaths() {
  const SECTIONS = [
    { id: "jing-sai", label: "竞赛经验", desc: "比赛项目、参赛经验、获奖技巧" },
    { id: "ke-she", label: "课设项目", desc: "课程设计、大作业、学期项目" },
    { id: "qiu-zhi", label: "求职实习", desc: "面试经验、实习心得、简历技巧" },
    { id: "xue-xi-zi-liao", label: "学习资料", desc: "笔记、真题、课件，按课程整理" },
    { id: "cai-keng", label: "踩坑记录", desc: "避坑指南、错误排查、经验教训" },
    { id: "hao-dong-xi", label: "好东西", desc: "音乐、游戏、美食，分享你喜欢的" },
    { id: "campus-pets", label: "校园宠物", desc: "校园里的学长学姐们" },
  ];
  return SECTIONS.map(({ id, label, desc }) => ({
    params: { section: id },
    props: { label, desc },
  }));
}

const { section } = Astro.params;
const { label, desc } = Astro.props;
const sectionInfo = { label, desc };

const btbuerPosts = await getCollection("btbuer");
const sectionPosts = btbuerPosts
  .filter(p => p.id.startsWith(`${section}/`) && !p.data.parent)
  .sort(
    (a, b) =>
      Math.floor(
        new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() / 1000
      ) -
      Math.floor(
        new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime() / 1000
      )
  )
  .filter(p => !p.data.draft);
---

<Layout
  title={`${sectionInfo.label} | 工商人共享`}
  description={`${sectionInfo.desc}——同学写给同学。`}
  noAds={true}
>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Hero -->
    <section data-section={section} class="border-border border-b py-12">
      <a href="/forbtbuer/" class="text-muted-foreground hover:text-foreground mb-6 block text-sm transition-colors">← 工商人共享</a>
      <h1 class="mb-3 text-4xl font-bold sm:text-5xl">{sectionInfo.label}</h1>
      <p class="text-muted-foreground max-w-md text-base">{sectionInfo.desc}</p>
    </section>

    <!-- Articles -->
    <section class="py-10">
      {sectionPosts.length > 0 ? (
        <ul>
          {sectionPosts.map(post => {
            const slug = post.id.split("/").pop();
            const href = `/forbtbuer/${section}/${slug}`;
            if (section === "campus-pets") {
              return (
                <li class="my-6">
                  <a href={href} class="flex gap-4 items-start active:opacity-60 transition-opacity">
                    {post.data.cover && (
                      <img
                        src={post.data.cover}
                        alt=""
                        style="width:72px;height:72px;border-radius:8px;object-fit:cover;flex-shrink:0;"
                      />
                    )}
                    <div class="flex-1">
                      <h3 class="text-accent text-lg font-medium hover:underline underline-offset-4">
                        {post.data.title}
                      </h3>
                      <div class="flex items-center gap-x-3">
                        <span class="text-muted-foreground text-sm">
                          {new Date(post.data.pubDatetime).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                        </span>
                        {post.data.author && (
                          <span class="text-muted-foreground text-sm before:mr-3 before:content-['·']">
                            {post.data.author}
                          </span>
                        )}
                      </div>
                      <p>{post.data.description}</p>
                    </div>
                  </a>
                </li>
              );
            }
            if (section === "hao-dong-xi") {
              const postData = { ...post.data, author: "" };
              return <Card variant="h3" href={href} {...(post as any)} data={postData} />;
            }
            return <Card variant="h3" href={href} {...(post as any)} />;
          })}
        </ul>
      ) : (
        <div class="py-20 text-center">
          <p class="text-muted-foreground text-sm">这个板块还没有内容</p>
          <a href="/btbuer-submit" class="text-foreground mt-2 inline-block text-sm underline underline-offset-4">
            成为第一个投稿的同学
          </a>
        </div>
      )}
    </section>

      <SubmitForm section={section} sectionLabel={label} />

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    const sectionEl = document.querySelector("[data-section]");
    const sec = (sectionEl as HTMLElement)?.dataset.section;
    if (main && sec) {
      main.setAttribute("data-backurl", `/forbtbuer/${sec}`);
      sessionStorage.setItem("backUrl", `/forbtbuer/${sec}`);
    }

    // Dynamic posts loading for this section
    if (sec) {
      loadDynamicPosts(sec);
    }
  });

  async function loadDynamicPosts(section: string) {
    const existingUl = document.querySelector("section.py-10 ul");
    if (!existingUl) return;

    let dynContainer = document.getElementById("dynamic-posts-list");
    if (!dynContainer) {
      dynContainer = document.createElement("div");
      dynContainer.id = "dynamic-posts-list";
      existingUl.parentElement?.appendChild(dynContainer);
    }

    try {
      const res = await fetch(`/api/pets?section=${encodeURIComponent(section)}`);
      const posts = await res.json();
      if (!Array.isArray(posts) || posts.length === 0) {
        return;
      }

      const separator = document.createElement("div");
      separator.className = "border-t border-border my-8 pt-2";
      separator.innerHTML = '<span class="text-xs text-muted-foreground">同学投稿</span>';

      const cards = posts.map((post: any) => {
        const href = `/forbtbuer/${section}/pet/?slug=${post.slug}`;
        const dateStr = new Date(post.created_at).toLocaleDateString("en-US", {
          month: "short", day: "numeric", year: "numeric"
        });
        return `
          <li class="my-6">
            <a href="${href}" class="flex gap-4 items-start active:opacity-60 transition-opacity">
              ${post.cover ? `<img src="${post.cover}" alt="" style="width:72px;height:72px;border-radius:8px;object-fit:cover;flex-shrink:0;" />` : ""}
              <div class="flex-1">
                <h3 class="text-accent text-lg font-medium hover:underline underline-offset-4">${post.name}</h3>
                <div class="flex items-center gap-x-3">
                  <span class="text-muted-foreground text-sm">${dateStr}</span>
                  ${post.author ? `<span class="text-muted-foreground text-sm before:mr-3 before:content-['·']">${post.author}</span>` : ""}
                </div>
                <p>${post.description}</p>
              </div>
            </a>
          </li>`;
      }).join("");

      dynContainer.innerHTML = separator.outerHTML + `<ul>${cards}</ul>`;
    } catch {
      // silently fail — static content still displays
    }
  }
</script>
