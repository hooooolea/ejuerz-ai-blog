---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

export function getStaticPaths() {
  const SECTIONS = [
    { id: "jing-sai", label: "竞赛经验", desc: "比赛项目、参赛经验、获奖技巧" },
    { id: "ke-she", label: "课设项目", desc: "课程设计、大作业、学期项目" },
    { id: "qiu-zhi", label: "求职实习", desc: "面试经验、实习心得、简历技巧" },
    { id: "xue-xi-zi-liao", label: "学习资料", desc: "笔记、真题、课件，按课程整理" },
    { id: "cai-keng", label: "踩坑记录", desc: "避坑指南、错误排查、经验教训" },
    { id: "campus-pets", label: "校园宠物", desc: "校园里的学长学姐们" },
  ];
  return SECTIONS.map(({ id, label, desc }) => ({
    params: { section: id },
    props: { label, desc },
  }));
}

const { section } = Astro.params;
const { label, desc } = Astro.props;
const sectionInfo = { label, desc };

const btbuerPosts = await getCollection("btbuer");
const sectionPosts = btbuerPosts
  .filter(p => p.id.startsWith(`${section}/`))
  .sort(
    (a, b) =>
      Math.floor(
        new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() / 1000
      ) -
      Math.floor(
        new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime() / 1000
      )
  )
  .filter(p => !p.data.draft);
---

<Layout
  title={`${sectionInfo.label} | 工商人共享`}
  description={`${sectionInfo.desc}——同学写给同学。`}
>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Hero -->
    <section data-section={section} class="border-border border-b py-12">
      <a href="/forbtbuer/" class="text-muted-foreground hover:text-foreground mb-6 block text-sm transition-colors">← 工商人共享</a>
      <h1 class="mb-3 text-4xl font-bold sm:text-5xl">{sectionInfo.label}</h1>
      <p class="text-muted-foreground max-w-md text-base">{sectionInfo.desc}</p>
    </section>

    <!-- Articles -->
    <section class="py-10">
      {sectionPosts.length > 0 ? (
        <ul>
          {sectionPosts.map(post => {
            const slug = post.id.split("/").pop();
            const href = `/forbtbuer/${section}/${slug}`;
            return <Card variant="h3" href={href} {...(post as any)} />;
          })}
        </ul>
      ) : (
        <div class="py-20 text-center">
          <p class="text-muted-foreground text-sm">这个板块还没有内容</p>
          <a href="/btbuer-submit" class="text-foreground mt-2 inline-block text-sm underline underline-offset-4">
            成为第一个投稿的同学
          </a>
        </div>
      )}
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    const sectionEl = document.querySelector("[data-section]");
    const sec = (sectionEl as HTMLElement)?.dataset.section;
    if (main && sec) {
      main.setAttribute("data-backurl", `/forbtbuer/${sec}`);
      sessionStorage.setItem("backUrl", `/forbtbuer/${sec}`);
    }
  });
</script>
