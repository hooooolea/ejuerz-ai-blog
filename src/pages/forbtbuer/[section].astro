---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BtbuerNavbar from "@/components/forbtbuer/BtbuerNavbar.vue";
import SectionDetailHero from "@/components/forbtbuer/SectionDetailHero.vue";
import PostList from "@/components/forbtbuer/PostList.vue";
import { BTBUER_SECTIONS } from "@/constants/btbuer-sections";

export function getStaticPaths() {
  return BTBUER_SECTIONS.map(({ id, label, desc }) => ({
    params: { section: id },
    props: { label, desc },
  }));
}

const { section } = Astro.params;
const { label, desc } = Astro.props;

const btbuerPosts = await getCollection("btbuer");
const sectionPosts = btbuerPosts
  .filter(p => p.id.startsWith(`${section}/`) && !p.data.parent)
  .sort(
    (a, b) =>
      Math.floor(
        new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() / 1000
      ) -
      Math.floor(
        new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime() / 1000
      )
  )
  .filter(p => !p.data.draft);

const posts = sectionPosts.map(post => {
  const slug = post.id.split("/").pop()!;
  return {
    href: `/forbtbuer/${section}/${slug}`,
    title: post.data.title,
    description: post.data.description,
    date: new Date(post.data.pubDatetime).toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
    author: post.data.author,
    cover: post.data.cover,
    showAuthor: section !== "hao-dong-xi" && Boolean(post.data.author),
  };
});
---

<Layout
  title={`${label} | 工商人共享`}
  description={`${desc}——同学写给同学。`}
  noAds={true}
>
  <BtbuerNavbar client:load />
  <main id="main-content" class="app-layout pb-10" data-section={section}>
    <SectionDetailHero
      label={label}
      desc={desc}
      postCount={posts.length}
    />
    <PostList
      posts={posts}
      showCover={section === "campus-pets"}
    />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    const sectionEl = document.querySelector("[data-section]");
    const sec = (sectionEl as HTMLElement)?.dataset.section;
    if (main && sec) {
      main.setAttribute("data-backurl", `/forbtbuer/${sec}`);
      sessionStorage.setItem("backUrl", `/forbtbuer/${sec}`);
    }
  });
</script>
