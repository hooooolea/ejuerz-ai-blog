---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const SECTIONS: Record<string, string> = {
  "jing-sai": "竞赛经验",
  "ke-she": "课设项目",
  "qiu-zhi": "求职实习",
  "xue-xi-zi-liao": "学习资料",
  "cai-keng": "踩坑记录",
  "hao-dong-xi": "好东西",
  "campus-pets": "校园宠物",
};

const allPosts = await getCollection("btbuer");
const searchData = allPosts
  .filter(p => !p.data.draft)
  .map(post => {
    const parts = post.id.split("/");
    const section = parts[0];
    const slug = parts[parts.length - 1].replace(/\.(md|mdx)$/, "");
    return {
      title: post.data.title,
      description: post.data.description ?? "",
      author: post.data.author ?? "",
      section: SECTIONS[section] ?? section,
      href: `/forbtbuer/${section}/${slug}`,
    };
  });
---

<Layout title="搜索 | 工商人共享" description="搜索工商人共享的所有内容" noAds={true}>
  <Header />
  <main id="main-content" class="app-layout">

    <section class="border-border border-b py-10">
      <a href="/forbtbuer/" class="text-muted-foreground hover:text-foreground mb-6 inline-block text-sm transition-colors">← 工商人共享</a>
      <h1 class="mb-5 text-3xl font-bold sm:text-4xl">搜索</h1>
      <div class="relative max-w-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="text-muted-foreground pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="搜标题、课程、作者……"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          class="border-border bg-background text-foreground placeholder:text-muted-foreground w-full rounded-lg border py-3 pl-9 pr-4 text-base outline-none focus:border-foreground"
        />
      </div>
    </section>

    <section class="py-6">
      <p id="search-hint" class="text-muted-foreground text-sm">输入关键词开始搜索</p>
      <p id="no-results" class="text-muted-foreground hidden text-sm">没有找到相关内容</p>
      <ul id="search-results"></ul>
    </section>

  </main>
  <Footer />
</Layout>

<script define:vars={{ searchData }}>
  const input = document.getElementById("search-input");
  const results = document.getElementById("search-results");
  const hint = document.getElementById("search-hint");
  const noResults = document.getElementById("no-results");

  function hl(text, q) {
    if (!q || !text) return text ?? "";
    const re = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi");
    return text.replace(re, '<mark style="background:var(--accent);opacity:0.25;border-radius:2px;padding:0 2px">$1</mark>');
  }

  function doSearch() {
    const q = (input?.value ?? "").trim().toLowerCase();

    if (!q) {
      hint.classList.remove("hidden");
      noResults.classList.add("hidden");
      results.innerHTML = "";
      return;
    }

    hint.classList.add("hidden");

    const terms = q.split(/\s+/).filter(Boolean);
    const matched = searchData.filter(r => {
      const hay = [r.title, r.description, r.author, r.section].join(" ").toLowerCase();
      return terms.every(t => hay.includes(t));
    });

    if (matched.length === 0) {
      noResults.classList.remove("hidden");
      results.innerHTML = "";
      return;
    }

    noResults.classList.add("hidden");
    results.innerHTML = matched.map(r => `
      <li style="margin: 1.5rem 0; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
        <a href="${r.href}" style="color: var(--accent); font-size: 1.1rem; font-weight: 500; text-decoration-style: dashed; text-underline-offset: 4px;">
          ${hl(r.title, q)}
        </a>
        <div style="color: var(--muted-foreground); font-size: 0.875rem; margin-top: 0.25rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <span>${hl(r.section, q)}</span>
          ${r.author ? `<span>· ${hl(r.author, q)}</span>` : ""}
        </div>
        ${r.description ? `<p style="font-size: 0.875rem; margin-top: 0.25rem;">${hl(r.description, q)}</p>` : ""}
      </li>
    `).join("");
  }

  input?.addEventListener("input", doSearch);

  // Support ?q= param
  const q = new URLSearchParams(window.location.search).get("q");
  if (q && input) {
    input.value = q;
    doSearch();
  }

  input?.focus();
</script>
