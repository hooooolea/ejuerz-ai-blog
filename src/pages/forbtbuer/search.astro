---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import { getAssetPath } from "@/utils/withBase";

const pagefindBundlePath = getAssetPath("pagefind/");
---

<Layout title="搜索 | 工商人共享" description="搜索工商人共享的所有内容">
  <Header dividerBorderClass="border-black dark:border-border" />
  <main id="main-content" class="app-layout pb-10">

    <section class="app-divider-b pt-4 pb-12">
      <a href="/forbtbuer/" class="text-muted-foreground hover:text-foreground mb-6 inline-block text-sm transition-colors">← 工商人共享</a>
      <h1 class="mb-6 text-4xl font-bold sm:text-5xl">搜索</h1>
      <div
        id="btbuer-search"
        transition:persist
        data-bundle-path={pagefindBundlePath}
      ></div>
    </section>

  </main>
</Layout>

<script>
  function initSearch() {
    const el = document.getElementById("btbuer-search");
    if (!el) return;

    const bundlePath = el.dataset.bundlePath;
    if (!bundlePath) return;

    const params = new URLSearchParams(window.location.search);
    const onIdle = window.requestIdleCallback || ((cb: () => void) => setTimeout(cb, 1));

    onIdle(async () => {
      if (import.meta.env.DEV) {
        el.innerHTML = `<div class="bg-muted/75 rounded p-4 mb-4"><p><strong>DEV 模式：</strong>需要先 build 一次才能看到搜索结果。</p></div>`;
      }

      // @ts-expect-error — no types for @pagefind/default-ui
      const { PagefindUI } = await import("@pagefind/default-ui");

      const search = new PagefindUI({
        element: "#btbuer-search",
        bundlePath,
        showImages: false,
        showSubResults: true,
        filters: { area: "btbuer" },
        processTerm: (term: string) => {
          params.set("q", term);
          history.replaceState(history.state, "", "?" + params.toString());
          return term;
        },
      });

      const q = params.get("q");
      if (q) search.triggerSearch(q);

      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      const reset = (e: Event) => {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      };
      searchInput?.addEventListener("input", reset);
      clearButton?.addEventListener("click", reset);
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const el = document.getElementById("btbuer-search");
    if (el && el.querySelector("form")) return;
    initSearch();
  });
  initSearch();
</script>

<style is:global>
  #btbuer-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--card-border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;

    form::before { background-color: var(--foreground); }
    input { font-weight: 400; border: 1px solid var(--card-border); background: var(--card); }
    .pagefind-ui__result {
      background: var(--card);
      border-color: var(--card-border);
    }
    input:focus-visible { outline: 1px solid var(--accent); }
    .pagefind-ui__result-title a {
      color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }
    .pagefind-ui__result:last-of-type { border-bottom: 0; }
  }
</style>
