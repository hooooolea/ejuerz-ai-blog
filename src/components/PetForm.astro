---
// PetForm — collapsible form for submitting new pets.
// Placed at the bottom of the campus-pets list page.
---

<div class="mt-8 border-t border-border pt-8" id="pet-form-section">
  <button
    id="toggle-pet-form"
    class="bg-foreground text-background hover:opacity-80 active:opacity-60 rounded-lg px-5 py-2.5 text-sm font-semibold transition-all"
  >
    ✦ 添加新宠物
  </button>

  <div id="pet-form-wrapper" class="hidden mt-6 border border-border rounded-lg p-6 max-w-lg">
    <h3 class="text-lg font-semibold mb-4">登记一只新宠物</h3>
    <form id="pet-form" class="flex flex-col gap-4">
      <div>
        <label class="text-sm font-medium block mb-1">宠物名字 <span class="text-red-500">*</span></label>
        <input
          id="pet-name"
          type="text"
          placeholder="比如：大黄、花花"
          maxlength="100"
          class="border-border bg-background text-foreground rounded-md border px-4 py-2 text-sm outline-none focus:ring-1 focus:ring-current w-full"
        />
      </div>

      <div>
        <label class="text-sm font-medium block mb-1">简短描述 <span class="text-red-500">*</span></label>
        <input
          id="pet-desc"
          type="text"
          placeholder="一句话介绍它（最多 200 字）"
          maxlength="200"
          class="border-border bg-background text-foreground rounded-md border px-4 py-2 text-sm outline-none focus:ring-1 focus:ring-current w-full"
        />
      </div>

      <div>
        <label class="text-sm font-medium block mb-1">详细介绍</label>
        <textarea
          id="pet-content"
          placeholder="品种、特征、活动区域、故事……（可选）"
          rows="4"
          class="border-border bg-background text-foreground rounded-md border px-4 py-2 text-sm outline-none focus:ring-1 focus:ring-current resize-none w-full"
        ></textarea>
      </div>

      <div>
        <label class="text-sm font-medium block mb-1">封面照片 <span class="text-red-500">*</span></label>
        <div class="flex items-center gap-3 flex-wrap">
          <label class="cursor-pointer text-sm bg-background border border-border hover:border-foreground rounded-md px-4 py-2 transition-colors">
            选择照片
            <input id="pet-cover-input" type="file" accept="image/*" class="hidden" />
          </label>
          <img id="pet-cover-preview" class="hidden h-20 w-20 rounded-md object-cover" src="" alt="" />
          <button type="button" id="pet-cover-remove" class="hidden text-xs text-red-500 hover:underline">移除</button>
          <span id="pet-cover-status" class="text-xs text-muted-foreground"></span>
        </div>
      </div>

      <div>
        <label class="text-sm font-medium block mb-1">额外照片（最多 10 张）</label>
        <div class="flex items-center gap-3 flex-wrap">
          <label class="cursor-pointer text-sm bg-background border border-border hover:border-foreground rounded-md px-4 py-2 transition-colors">
            添加照片
            <input id="pet-images-input" type="file" accept="image/*" multiple class="hidden" />
          </label>
          <span id="pet-images-status" class="text-xs text-muted-foreground"></span>
        </div>
        <div id="pet-images-previews" class="flex gap-2 mt-2 flex-wrap"></div>
      </div>

      <div>
        <label class="text-sm font-medium block mb-1">你的昵称</label>
        <input
          id="pet-author"
          type="text"
          placeholder="不填默认匿名"
          maxlength="20"
          class="border-border bg-background text-foreground rounded-md border px-4 py-2 text-sm outline-none focus:ring-1 focus:ring-current w-full"
        />
      </div>

      <div class="flex items-center gap-4">
        <button
          type="submit"
          class="bg-foreground text-background rounded-md px-5 py-2 text-sm font-medium active:opacity-70 transition-opacity"
        >
          提交
        </button>
        <span id="pet-form-status" class="text-muted-foreground text-sm"></span>
      </div>
    </form>
  </div>
</div>

<script>
  const PETS_API = "/api/pets";
  const UPLOAD_API = "/api/upload";
  let petCoverUrl: string | null = null;
  let petImageUrls: string[] = [];

  function resetPetForm() {
    (document.getElementById("pet-name") as HTMLInputElement).value = "";
    (document.getElementById("pet-desc") as HTMLInputElement).value = "";
    (document.getElementById("pet-content") as HTMLTextAreaElement).value = "";
    (document.getElementById("pet-author") as HTMLInputElement).value = "";
    (document.getElementById("pet-cover-input") as HTMLInputElement).value = "";
    (document.getElementById("pet-images-input") as HTMLInputElement).value = "";
    document.getElementById("pet-cover-preview")?.classList.add("hidden");
    document.getElementById("pet-cover-remove")?.classList.add("hidden");
    (document.getElementById("pet-cover-status") as HTMLSpanElement).textContent = "";
    (document.getElementById("pet-images-status") as HTMLSpanElement).textContent = "";
    (document.getElementById("pet-images-previews") as HTMLDivElement).innerHTML = "";
    petCoverUrl = null;
    petImageUrls = [];
  }

  document.addEventListener("astro:page-load", () => {
    const toggleBtn = document.getElementById("toggle-pet-form");
    const wrapper = document.getElementById("pet-form-wrapper");

    if (toggleBtn && wrapper) {
      toggleBtn.addEventListener("click", () => {
        const isHidden = wrapper.classList.contains("hidden");
        wrapper.classList.toggle("hidden");
        toggleBtn.textContent = isHidden ? "收起" : "✦ 添加新宠物";
      });
    }

    // Cover image upload + preview
    const coverInput = document.getElementById("pet-cover-input") as HTMLInputElement | null;
    const coverPreview = document.getElementById("pet-cover-preview") as HTMLImageElement | null;
    const coverRemove = document.getElementById("pet-cover-remove") as HTMLButtonElement | null;
    const coverStatus = document.getElementById("pet-cover-status") as HTMLSpanElement | null;

    if (coverInput && coverPreview && coverRemove && coverStatus) {
      coverInput.addEventListener("change", async () => {
        const file = coverInput.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (e) => {
          coverPreview.src = e.target?.result as string;
          coverPreview.classList.remove("hidden");
          coverRemove.classList.remove("hidden");
        };
        reader.readAsDataURL(file);

        coverStatus.textContent = "上传中...";
        const formData = new FormData();
        formData.append("file", file);
        try {
          const res = await fetch(UPLOAD_API, { method: "POST", body: formData });
          const data = await res.json();
          if (data.url) {
            petCoverUrl = data.url;
            coverStatus.textContent = "上传成功 ✓";
          } else {
            coverStatus.textContent = data.error ?? "上传失败";
            coverPreview.classList.add("hidden");
            coverRemove.classList.add("hidden");
          }
        } catch {
          coverStatus.textContent = "上传失败";
          coverPreview.classList.add("hidden");
          coverRemove.classList.add("hidden");
        }
      });

      coverRemove.addEventListener("click", () => {
        petCoverUrl = null;
        coverInput.value = "";
        coverPreview.classList.add("hidden");
        coverRemove.classList.add("hidden");
        coverStatus.textContent = "";
      });
    }

    // Additional images upload + previews
    const imagesInput = document.getElementById("pet-images-input") as HTMLInputElement | null;
    const imagesStatus = document.getElementById("pet-images-status") as HTMLSpanElement | null;
    const imagesPreviews = document.getElementById("pet-images-previews") as HTMLDivElement | null;

    if (imagesInput && imagesStatus && imagesPreviews) {
      imagesInput.addEventListener("change", async () => {
        const files = imagesInput.files;
        if (!files || files.length === 0) return;

        petImageUrls = [];
        imagesPreviews.innerHTML = "";
        imagesStatus.textContent = `上传 ${files.length} 张...`;

        for (const file of Array.from(files)) {
          const reader = new FileReader();
          const img = document.createElement("img");
          img.className = "h-16 w-16 rounded-md object-cover";
          reader.onload = (e) => { img.src = e.target?.result as string; };
          reader.readAsDataURL(file);
          imagesPreviews.appendChild(img);

          const formData = new FormData();
          formData.append("file", file);
          try {
            const res = await fetch(UPLOAD_API, { method: "POST", body: formData });
            const data = await res.json();
            if (data.url) {
              petImageUrls.push(data.url);
            }
          } catch {
            // skip failed upload
          }
        }

        imagesStatus.textContent = petImageUrls.length > 0
          ? `${petImageUrls.length}/${files.length} 张上传成功 ✓`
          : "上传失败";
      });
    }

    // Form submit
    const form = document.getElementById("pet-form") as HTMLFormElement | null;
    const formStatus = document.getElementById("pet-form-status") as HTMLSpanElement | null;

    if (form && formStatus) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const lastSent = localStorage.getItem("pet_last_sent");
        if (lastSent && Date.now() - parseInt(lastSent) < 5 * 60 * 1000) {
          formStatus.textContent = "提交太频繁，请 5 分钟后再试";
          return;
        }

        const name = (document.getElementById("pet-name") as HTMLInputElement).value.trim();
        const description = (document.getElementById("pet-desc") as HTMLInputElement).value.trim();
        const content = (document.getElementById("pet-content") as HTMLTextAreaElement).value.trim();
        const author = (document.getElementById("pet-author") as HTMLInputElement).value.trim();

        if (!name || !description) {
          formStatus.textContent = "名字和描述不能为空";
          return;
        }

        if (!petCoverUrl) {
          formStatus.textContent = "请上传封面照片";
          return;
        }

        formStatus.textContent = "提交中...";

        try {
          const res = await fetch(PETS_API, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name,
              description,
              content,
              cover: petCoverUrl,
              images: petImageUrls,
              author: author || "匿名",
            }),
          });

          if (res.ok) {
            localStorage.setItem("pet_last_sent", String(Date.now()));
            formStatus.textContent = "提交成功 ✓ 新宠物已添加！";
            resetPetForm();
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            const err = await res.json();
            formStatus.textContent = (err as any).error ?? "提交失败";
          }
        } catch {
          formStatus.textContent = "网络错误，请重试";
        }
      });
    }
  });
</script>
