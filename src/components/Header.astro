---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent inset-s-16 absolute -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div
    class="border-border bg-background flex w-full items-center justify-between border-b py-4 sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "forbtbuer")}
      class="py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
    >
      BTBU Forum
    </a>
    <nav class="flex items-center gap-x-4">
      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "forbtbuer/search")}
            class="focus-outline relative size-8"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only">{t.nav.search}</span>
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline hover:[&>svg]:stroke-accent relative size-8 p-0"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </nav>
  </div>
</header>
