---
const isChinese = Astro.currentLocale === "cn";
const href = isChinese ? "/" : "/cn";
const label = isChinese ? "EN" : "中文";
const title = isChinese ? "Switch to English" : "切换到中文";
---

<a href={href} title={title} aria-label={title} class="lang-switcher">
  {label}
</a>

<style>
  .lang-switcher {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background-color: var(--accent);
    color: var(--accent-foreground);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      opacity 0.15s ease;
    opacity: 0.88;
  }

  .lang-switcher:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    opacity: 1;
  }
</style>
